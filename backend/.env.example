# Copy this file to backend/.env and fill in the values from Google Cloud Console.
# (backend/.env is in .gitignore, so your secret is never pushed to GitHub.)

GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Optional: only these Google accounts may sign in (comma-separated).
# Leave empty to let every "test user" you added in Google Cloud sign in.
ALLOWED_EMAILS=

# The project owner: only these accounts may use the SQL console (it can see everyone's data).
ADMIN_EMAILS=you@gmail.com

# Optional settings
# GOOGLE_REDIRECT_URI=https://jobtrail-onkj.onrender.com/api/auth/google/callback
# GMAIL_FIRST_SYNC_DAYS=365
# GMAIL_AUTO_SYNC_HOURS=1
# GMAIL_JOBS_LABEL=Jobs        # your Gmail label for job emails (read from any sender)
# APP_TIMEZONE=Asia/Kolkata

# Keep data when the host wipes its disk (Render free plan): a free Turso database
# TURSO_DATABASE_URL=libsql://jobtrail-yourname.turso.io
# TURSO_AUTH_TOKEN=xxxxxxxx
