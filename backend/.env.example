# Copy this file to backend/.env and fill in the values from Google Cloud Console.
# (backend/.env is in .gitignore, so your secret is never pushed to GitHub.)

GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Optional: only these Google accounts may sign in (comma-separated). Recommended for the public site.
ALLOWED_EMAILS=you@gmail.com

# Optional settings
# GOOGLE_REDIRECT_URI=https://jobtrail-onkj.onrender.com/api/auth/google/callback
# GMAIL_FIRST_SYNC_DAYS=365
# GMAIL_AUTO_SYNC_HOURS=3
# APP_TIMEZONE=Asia/Kolkata
